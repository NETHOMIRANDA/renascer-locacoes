# =========================================================
# CONFIGURAÇÃO SUPABASE (PostgreSQL na nuvem)
# Copie este arquivo para .env e preencha com suas credenciais
# =========================================================

# 1. Acesse https://supabase.com → seu projeto → Settings → API
# 2. Project URL → cole em SUPABASE_URL
# 3. service_role key (NÃO a anon key!) → cole em SUPABASE_KEY
#    ⚠️ A service_role key dá acesso total ao banco — guarde com segurança

SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-service-role-key-aqui

# =========================================================
# CONFIGURAÇÃO NUVEM (Google Apps Script) - OPCIONAL
# Mantido para compatibilidade com sincronização do PWA web
# =========================================================

# URL do seu Apps Script (deploy → "Executar como: Eu", "Acesso: Qualquer pessoa")
# Deve terminar em /exec
NUVEM_URL=https://script.google.com/macros/s/SEU_SCRIPT_ID/exec

# Senha do administrador (padrão: A103114)
NUVEM_SENHA=A103114

# Sincronização automática (true/false)
NUVEM_AUTO_SYNC=true